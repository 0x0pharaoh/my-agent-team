# Hermes adapter for my-team
# Rendered by `my-team install hermes` — do not edit manually.
# Placeholder {cli_path} is replaced with the absolute path to my-team.exe.
#
# This file contains the shell `hooks:` block. The MCP server definition
# (mcp_servers:) lives in mcp_servers.yaml.tmpl — merge both into
# ~/.hermes/config.yaml. The bridge plugin is a separate Python package
# dropped into $HERMES_HOME/plugins/ (not controlled by config.yaml).
#
# First-use consent is required for each (event, command) pair.
# See README.md §1.3 for the consent flow and hook semantics.

hooks:
  on_session_start:
    - command: "{cli_path} hook session-start --agent hermes"
      timeout: 30
      fail_closed: false
  pre_llm_call:
    - command: "{cli_path} hook pre-llm --agent hermes"
      timeout: 30
      fail_closed: false
  pre_tool_call:
    - matcher: "^my-team.*"
      command: "{cli_path} hook pre-tool --agent hermes"
      timeout: 30
      fail_closed: true
